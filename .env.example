# Copy this file to .env for local development. Do not commit real secrets.

API_PREFIX=/api/v1
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

DBMS_URL=jdbc:mysql://localhost:3306/identity
DBMS_USERNAME=root
DBMS_PASSWORD=changeme

JWT_SIGNER_KEY=replace-with-base64-secret
JWT_VALID_DURATION=360000
JWT_REFRESHABLE_DURATION=360000

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/authenticate

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=changeme
CHAT_MONGODB_URI=mongodb://root:changeme@localhost:27017/chat-service?authSource=admin
FILE_MONGODB_URI=mongodb://root:changeme@localhost:27017/file-service?authSource=admin
NOTIFICATION_MONGODB_URI=mongodb://root:changeme@localhost:27017/notification-service?authSource=admin
POST_MONGODB_URI=mongodb://root:changeme@localhost:27017/post-service?authSource=admin

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=changeme

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
BREVO_API_KEY=replace-with-brevo-api-key

IDENTITY_SERVICE_BASE_URL=http://localhost:8080/identity
PROFILE_SERVICE_BASE_URL=http://localhost:8081/profile
CHAT_SERVICE_URL=http://localhost:8085
FILE_STORAGE_DIR=./uploads
FILE_DOWNLOAD_PREFIX=http://localhost:8888/api/v1/file/media/download/
