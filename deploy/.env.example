# Environment of the production stack. On the server this file is /opt/zapoo/.env (permissions 600).
# In the GitHub repository it lives in the "production" environment secret PROD_ENV_FILE (the whole file content),
# the deploy workflow writes it to the server. Never commit the real file.
#
# Use passwords made of letters and digits only (openssl rand -hex 24): some of them end up inside a URL
# (MongoDB) or a shell command (health checks).

# ---- public address of the gateway as browsers see it (no trailing slash). Without a domain: http://<EC2 public IP>:8888
PUBLIC_BASE_URL=http://203.0.113.10:8888

# ---- container images (set by the deploy script, REGISTRY only needs changing if the repo moves)
# REGISTRY=ghcr.io/zapoo-capoo/backend
# IMAGE_TAG=latest

# ---- identity-service (MySQL + JWT + Google login)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=identity
MYSQL_USER=identity
MYSQL_PASSWORD=change-me-mysql
# at least 32 characters, keep it secret: it signs every login token
JWT_SIGNER_KEY=change-me-at-least-32-characters-long-secret
JWT_VALID_DURATION=360000
JWT_REFRESHABLE_DURATION=360000
# Optional, only for "login with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/authenticate

# ---- profile-service (Neo4j)
NEO4J_PASSWORD=change-me-neo4j

# ---- chat-service (MongoDB + Redis)
MONGO_USER=root
MONGO_PASSWORD=change-me-mongo
REDIS_PASSWORD=change-me-redis

# ---- storage-service (PostgreSQL + S3)
POSTGRES_DB=storage
POSTGRES_USER=storage
POSTGRES_PASSWORD=change-me-postgres
STORAGE_SIGNATURE_SECRET=change-me-signature
S3_BUCKET=your-bucket-name
S3_REGION=ap-southeast-1
# default = IAM role attached to the EC2 instance (recommended, no keys on the server).
# static = use the two keys below.
S3_CREDENTIALS_MODE=default
S3_ACCESS_KEY=
S3_SECRET_KEY=
